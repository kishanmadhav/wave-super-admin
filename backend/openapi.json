  "info": {
    "title": "Wave Super Admin API",
    "description": "Platform operator API — Wave Super Admin console",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Admin identity"
    },
    {
      "name": "users",
      "description": "Platform user management"
    },
    {
      "name": "catalog",
      "description": "Releases & tracks"
    },
    {
      "name": "creators",
      "description": "Creator entities (artists & labels)"
    },
    {
      "name": "pipelines",
      "description": "Verification & review queues"
    },
    {
      "name": "disputes",
      "description": "Dispute case management"
    },
    {
      "name": "wallets",
      "description": "Ledger & wallets"
    },
    {
      "name": "system",
      "description": "Platform parameters, feature flags & taxonomies"
    },
    {
      "name": "audit",
      "description": "Audit trail"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Supabase-issued JWT — obtained via supabase.auth.signInWithPassword on the frontend"
      }
    },
    "schemas": {
      "SignedUploadDto": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "string",
            "enum": [
              "audio",
              "images"
            ],
            "description": "Supabase Storage bucket name"
          },
          "path": {
            "type": "string",
            "example": "tracks/my-release-id/song.wav",
            "description": "Object path inside the bucket (no leading slash)"
          }
        },
        "required": [
          "bucket",
          "path"
        ]
      },
      "SignedReadDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "audio/tracks/my-release-id/song.wav",
            "description": "Full storage key: \"{bucket}/{path}\""
          },
          "expiresIn": {
            "type": "number",
            "example": 3600,
            "description": "URL lifetime in seconds. Min 60 (1 min), max 43200 (12 h). Default 3600."
          }
        },
        "required": [
          "key"
        ]
      }
    }
  }
}